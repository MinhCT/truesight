# LiquipediaDota2 Configuration
# Copy this file to .env and fill in your actual values

# Required: Authentication token for the API service
TAP_LIQUIPEDIA_DOTA2_USER_AGENT=your_user_agent_here

# Optional: API URL (defaults to https://liquipedia.com/dota2)
TAP_LIQUIPEDIA_DOTA2_API_URL=https://liquipedia.com/dota2
