# YoutubePersona Configuration
# Copy this file to .env and fill in your actual values

# Required: Authentication information for the Youtube API service
TAP_YOUTUBE_PERSONA_REFRESH_TOKEN=your_auth_token_here
TAP_YOUTUBE_PERSONA_GOOGLE_CLIENT_ID=your_google_client_id
TAP_YOUTUBE_PERSONA_GOOGLE_CLIENT_SECRET=your_google_client_secret

# Required: Project IDs to replicate (comma-separated)
TAP_YOUTUBE_PERSONA_PROJECT_IDS=project1,project2,project3

# Optional: The earliest record date to sync (ISO format)
TAP_YOUTUBE_PERSONA_START_DATE=2023-01-01T00:00:00Z

# Optional: Youtube API URL
TAP_YOUTUBE_PERSONA_YOUTUBE_API_URL=https://youtube.googleapis.com/youtube/v3
